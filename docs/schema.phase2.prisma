// schema.phase2.prisma — CPA Cricket Academy CRM, Phase 2 (additive only)
//
// HOW TO USE
// - Preferred: Prisma multi-file schema (prisma/schema/ folder). Keep Phase 1 in its file(s),
//   put this file beside them.
// - Otherwise: append the contents below to prisma/schema.prisma.
//
// VERIFIED AGAINST PHASE 1 (see DATABASE-DESIGN-PHASE-2.md section 9)
// - Phase 1 models are named Branch, User, Student, Batch, with String cuid ids.
// - Phase 1 tables in PostgreSQL are PascalCase ("Branch", "User", "Student", "Batch") with NO @map.
// - Relations in this schema reference the Phase 1 models directly.
//
// PHASE 1 TOUCH: Prisma requires both sides of every relation. Add the back-relation fields listed
// at the very end of this file to the Phase 1 models. They create NO SQL.
// Check: `prisma migrate diff` must output only CREATE statements for the tables below.

// ---------- Enums ----------

enum EnquiryStatus {
  NEW
  CONTACTED
  TRIAL_SCHEDULED
  TRIAL_DONE
  CONVERTED
  LOST
}

enum EnquirySource {
  WALK_IN
  PHONE
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  OTHER
}

enum EnquiryCreatedVia {
  MANUAL
  WEBSITE_FORM
}

enum FollowUpChannel {
  CALL
  WHATSAPP
  VISIT
}

enum ConsentChannel {
  WHATSAPP
}

enum ConsentCaptureMethod {
  FORM_CHECKBOX
  STAFF_RECORDED
}

enum TrialStatus {
  SCHEDULED
  ATTENDED
  NO_SHOW
  CANCELLED
}

enum NotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ReconciliationStatus {
  OK
  MISMATCH
}

enum ContentType {
  PAGE
  ANNOUNCEMENT
  GALLERY
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------- Enquiries ----------

model Enquiry {
  id                  String            @id @default(cuid())
  branchId            String            @map("branch_id")
  childName           String            @map("child_name")
  guardianName        String?           @map("guardian_name")
  phone               String
  phoneNormalized     String            @map("phone_normalized")
  email               String?
  childAgeYears       Int?              @map("child_age_years")
  interest            String?
  source              EnquirySource
  sourceDetail        String?           @map("source_detail")
  createdVia          EnquiryCreatedVia @default(MANUAL) @map("created_via")
  status              EnquiryStatus     @default(NEW)
  assignedToUserId    String?           @map("assigned_to_user_id")
  lostReasonId        String?           @map("lost_reason_id")
  lostNote            String?           @map("lost_note")
  nextFollowUpAt      DateTime?         @map("next_follow_up_at") // derived; see A-06
  lastContactedAt     DateTime?         @map("last_contacted_at")
  possibleDuplicate   Boolean           @default(false) @map("possible_duplicate")
  mergedIntoId        String?           @map("merged_into_id")
  convertedStudentId  String?           @unique @map("converted_student_id")
  convertedAt         DateTime?         @map("converted_at")
  createdByUserId     String?           @map("created_by_user_id")
  anonymizedAt        DateTime?         @map("anonymized_at")
  version             Int               @default(1)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")

  branch            Branch                @relation("EnquiryBranch", fields: [branchId], references: [id])
  assignedTo        User?                 @relation("EnquiryAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy         User?                 @relation("EnquiryCreatedBy", fields: [createdByUserId], references: [id])
  convertedStudent  Student?              @relation("EnquiryConvertedStudent", fields: [convertedStudentId], references: [id])
  lostReason        LostReason?           @relation(fields: [lostReasonId], references: [id])
  mergedInto        Enquiry?              @relation("EnquiryMerge", fields: [mergedIntoId], references: [id])
  mergedFrom        Enquiry[]             @relation("EnquiryMerge")
  stageHistory      EnquiryStageHistory[]
  followUps         EnquiryFollowUp[]
  consents          EnquiryConsent[]
  trials            TrialSession[]

  @@index([branchId, status])
  @@index([branchId, assignedToUserId, status])
  @@index([assignedToUserId, nextFollowUpAt])
  @@index([phoneNormalized])
  @@index([branchId, createdAt])
  @@index([source, createdAt])
  @@map("enquiries")
}

model EnquiryStageHistory {
  id              String         @id @default(cuid())
  enquiryId       String         @map("enquiry_id")
  fromStatus      EnquiryStatus? @map("from_status")
  toStatus        EnquiryStatus  @map("to_status")
  changedByUserId String?        @map("changed_by_user_id")
  note            String?
  createdAt       DateTime       @default(now()) @map("created_at")

  enquiry   Enquiry @relation(fields: [enquiryId], references: [id])
  changedBy User?   @relation("StageHistoryChangedBy", fields: [changedByUserId], references: [id])

  @@index([enquiryId, createdAt])
  @@map("enquiry_stage_history")
}

model EnquiryFollowUp {
  id              String          @id @default(cuid())
  enquiryId       String          @map("enquiry_id")
  dueAt           DateTime        @map("due_at")
  channel         FollowUpChannel
  note            String?
  outcome         String?
  doneAt          DateTime?       @map("done_at")
  doneByUserId    String?         @map("done_by_user_id")
  cancelledAt     DateTime?       @map("cancelled_at")
  createdByUserId String          @map("created_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  enquiry   Enquiry @relation(fields: [enquiryId], references: [id])
  doneBy    User?   @relation("FollowUpDoneBy", fields: [doneByUserId], references: [id])
  createdBy User    @relation("FollowUpCreatedBy", fields: [createdByUserId], references: [id])

  @@index([enquiryId, doneAt])
  @@index([dueAt])
  // Migration SQL adds a partial index:
  //   CREATE INDEX enquiry_follow_ups_open_due_idx ON enquiry_follow_ups (due_at)
  //   WHERE done_at IS NULL AND cancelled_at IS NULL;
  @@map("enquiry_follow_ups")
}

model EnquiryConsent {
  id               String               @id @default(cuid())
  enquiryId        String               @map("enquiry_id")
  channel          ConsentChannel
  grantedAt        DateTime             @map("granted_at")
  captureMethod    ConsentCaptureMethod @map("capture_method")
  textVersion      String               @map("text_version")
  recordedByUserId String?              @map("recorded_by_user_id")
  revokedAt        DateTime?            @map("revoked_at")
  createdAt        DateTime             @default(now()) @map("created_at")

  enquiry    Enquiry @relation(fields: [enquiryId], references: [id])
  recordedBy User?   @relation("ConsentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([enquiryId, channel, createdAt])
  @@map("enquiry_consents")
}

model LostReason {
  id        String    @id @default(cuid())
  code      String    @unique
  label     String
  sortOrder Int       @default(0) @map("sort_order")
  active    Boolean   @default(true)
  enquiries Enquiry[]

  @@map("lost_reasons")
}

model TrialSession {
  id                    String      @id @default(cuid())
  enquiryId             String      @map("enquiry_id")
  batchId               String      @map("batch_id")
  sessionDate           DateTime    @map("session_date") @db.Date
  status                TrialStatus @default(SCHEDULED)
  outcomeMarkedByUserId String?     @map("outcome_marked_by_user_id")
  outcomeMarkedAt       DateTime?   @map("outcome_marked_at")
  note                  String?
  createdByUserId       String      @map("created_by_user_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  enquiry       Enquiry @relation(fields: [enquiryId], references: [id])
  batch         Batch   @relation("TrialBatch", fields: [batchId], references: [id])
  outcomeMarker User?   @relation("TrialOutcomeMarker", fields: [outcomeMarkedByUserId], references: [id])
  createdBy     User    @relation("TrialCreatedBy", fields: [createdByUserId], references: [id])

  @@unique([enquiryId, batchId, sessionDate])
  @@index([batchId, sessionDate])
  @@index([enquiryId])
  @@map("trial_sessions")
}

// ---------- Notifications ----------

model NotificationEvent {
  id        String               @id @default(cuid())
  type      String
  branchId  String?              @map("branch_id")
  dedupeKey String               @unique @map("dedupe_key")
  severity  NotificationSeverity @default(INFO)
  payload   Json                 // ids and counts only; no personal data
  createdAt DateTime             @default(now()) @map("created_at")

  branch        Branch?        @relation("NotificationEventBranch", fields: [branchId], references: [id])
  notifications Notification[]

  @@index([type, createdAt])
  @@map("notification_events")
}

model Notification {
  id              String    @id @default(cuid())
  eventId         String    @map("event_id")
  recipientUserId String    @map("recipient_user_id")
  readAt          DateTime? @map("read_at")
  dismissedAt     DateTime? @map("dismissed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  event     NotificationEvent @relation(fields: [eventId], references: [id])
  recipient User              @relation("NotificationRecipient", fields: [recipientUserId], references: [id])

  @@unique([eventId, recipientUserId])
  @@index([recipientUserId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  eventType String  @map("event_type")
  inApp     Boolean @default(true) @map("in_app")
  inDigest  Boolean @default(false) @map("in_digest")

  user User @relation("NotificationPrefUser", fields: [userId], references: [id])

  @@unique([userId, eventType])
  @@map("notification_preferences")
}

model NotificationUserSetting {
  id          String  @id @default(cuid())
  userId      String  @unique @map("user_id")
  quietStart  String? @map("quiet_start") // "HH:mm" in Asia/Kolkata
  quietEnd    String? @map("quiet_end")
  digestTime  String? @map("digest_time")

  user User @relation("NotificationSettingUser", fields: [userId], references: [id])

  @@map("notification_user_settings")
}

// ---------- Metrics ----------

model MetricDailyBranch {
  id                       String   @id @default(cuid())
  branchId                 String   @map("branch_id")
  businessDate             DateTime @map("business_date") @db.Date
  collectionsCashPaise     Int      @default(0) @map("collections_cash_paise")
  collectionsOnlinePaise   Int      @default(0) @map("collections_online_paise")
  reversalsPaise           Int      @default(0) @map("reversals_paise")
  outstandingPaise         Int      @default(0) @map("outstanding_paise")
  overduePaise             Int      @default(0) @map("overdue_paise")
  activeStudents           Int      @default(0) @map("active_students")
  attendanceSessionsMarked Int      @default(0) @map("attendance_sessions_marked")
  attendancePresent        Int      @default(0) @map("attendance_present")
  attendanceAbsent         Int      @default(0) @map("attendance_absent")
  enquiriesCreated         Int      @default(0) @map("enquiries_created")
  enquiriesContacted       Int      @default(0) @map("enquiries_contacted")
  enquiriesConverted       Int      @default(0) @map("enquiries_converted")
  enquiriesLost            Int      @default(0) @map("enquiries_lost")
  trialsAttended           Int      @default(0) @map("trials_attended")
  computedAt               DateTime @map("computed_at")
  sourceVersion            Int      @default(1) @map("source_version")

  branch Branch @relation("MetricBranch", fields: [branchId], references: [id])

  @@unique([branchId, businessDate])
  @@index([businessDate])
  @@map("metric_daily_branch")
}

model MetricReconciliationRun {
  id           String               @id @default(cuid())
  businessDate DateTime             @map("business_date") @db.Date
  branchId     String?              @map("branch_id")
  status       ReconciliationStatus
  details      Json?
  createdAt    DateTime             @default(now()) @map("created_at")

  branch Branch? @relation("ReconBranch", fields: [branchId], references: [id])

  @@index([businessDate, status])
  @@map("metric_reconciliation_runs")
}

// ---------- Content manager ----------

model ContentPage {
  id                  String        @id @default(cuid())
  scopeKey            String        @map("scope_key") // "global" or the branch id
  branchId            String?       @map("branch_id")
  slug                String
  type                ContentType
  status              ContentStatus @default(DRAFT)
  publishedRevisionId String?       @unique @map("published_revision_id")
  createdByUserId     String        @map("created_by_user_id")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  archivedAt          DateTime?     @map("archived_at")

  branch            Branch?           @relation("ContentBranch", fields: [branchId], references: [id])
  createdBy         User              @relation("ContentCreatedBy", fields: [createdByUserId], references: [id])
  publishedRevision ContentRevision?  @relation("PublishedRevision", fields: [publishedRevisionId], references: [id])
  revisions         ContentRevision[] @relation("PageRevisions")

  @@unique([scopeKey, slug])
  @@index([branchId, status])
  @@map("content_pages")
}

model ContentRevision {
  id              String   @id @default(cuid())
  pageId          String   @map("page_id")
  revisionNumber  Int      @map("revision_number")
  title           String
  bodyMarkdown    String   @map("body_markdown")
  summary         String?
  createdByUserId String   @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  page          ContentPage            @relation("PageRevisions", fields: [pageId], references: [id])
  createdBy     User                   @relation("RevisionCreatedBy", fields: [createdByUserId], references: [id])
  publishedFor  ContentPage?           @relation("PublishedRevision")
  media         ContentRevisionMedia[]

  @@unique([pageId, revisionNumber])
  @@map("content_revisions")
}

model MediaAsset {
  id               String    @id @default(cuid())
  scopeKey         String    @map("scope_key")
  branchId         String?   @map("branch_id")
  storageKey       String    @unique @map("storage_key")
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  width            Int
  height           Int
  altText          String    @map("alt_text")
  uploadedByUserId String    @map("uploaded_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  branch     Branch?                @relation("MediaBranch", fields: [branchId], references: [id])
  uploadedBy User                   @relation("MediaUploadedBy", fields: [uploadedByUserId], references: [id])
  revisions  ContentRevisionMedia[]

  @@index([scopeKey, createdAt])
  @@map("media_assets")
}

model ContentRevisionMedia {
  revisionId String @map("revision_id")
  mediaId    String @map("media_id")
  sortOrder  Int    @default(0) @map("sort_order")

  revision ContentRevision @relation(fields: [revisionId], references: [id])
  media    MediaAsset      @relation(fields: [mediaId], references: [id])

  @@id([revisionId, mediaId])
  @@map("content_revision_media")
}

model PublicBatchListing {
  batchId         String   @id @map("batch_id")
  visible         Boolean  @default(false)
  displayName     String?  @map("display_name")
  note            String?
  updatedByUserId String   @map("updated_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")

  batch     Batch @relation("ListingBatch", fields: [batchId], references: [id])
  updatedBy User  @relation("ListingUpdatedBy", fields: [updatedByUserId], references: [id])

  @@map("public_batch_listings")
}

// ---------- Platform ----------

model FeatureFlag {
  id              String   @id @default(cuid())
  key             String
  scopeKey        String   @map("scope_key") // "global" or the branch id
  enabled         Boolean  @default(false)
  updatedByUserId String?  @map("updated_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([key, scopeKey])
  @@map("feature_flags")
}

